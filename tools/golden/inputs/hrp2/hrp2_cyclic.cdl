/*
 * Synthetic application: HRP2CyclicHandlerPlugin. See README.md in this directory.
 * Kept ASCII-only because tecsgen reads it with -k euc.
 */
import("kernel.cdl");

celltype tHandlerBody {
	entry siHandlerBody eiBody;
};

[domain(HRP2, "trusted")]
region rKernel {
	cell tHandlerBody Body { };
	cell tCyclicHandler CyclicK {
		ciBody = Body.eiBody;
		cyclicTime = 100;
	};
};
