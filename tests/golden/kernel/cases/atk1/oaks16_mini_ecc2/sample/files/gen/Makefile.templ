# var #_MVAR_#
# fixed variable (unchangeable by config or plugin)
TARGET_BASE = sample
BASE_DIR = .
GEN_DIR = $(BASE_DIR)/gen
INCLUDES = -I $(BASE_DIR)/. -I $(BASE_DIR)/../../../config/m16c-renesas -I $(BASE_DIR)/../../../config/m16c-renesas/oaks16_mini -I $(BASE_DIR)/../../../include -I $(BASE_DIR)/../../.. -I $(BASE_DIR)/../../../syslib -I $(BASE_DIR)/../../../syslib/m16c-renesas/oaks16_mini -I $(BASE_DIR)/. -I $(TECSPATH) -I $(TECSPATH)/mruby -I $(TECSPATH)/rpc -I $(TECSPATH)/TLSFMalloc -I $(TECSPATH)/DataPumpHolder -I $(TECSPATH)/posix -I $(TECSPATH)/TECSInfo -I $(GEN_DIR)
DEFINES = -D TECS

# end of fixed variable (unchangeable by config or plugin)
#default C Compiler
CC = gcc

#default C Compiler options
CFLAGS = $(INCLUDES) $(DEFINES) -D  "Inline=static inline"

#default Liknker
LD = gcc

#default Liknker Options
LDFLAGS = 

#default source directory
SRC_DIR = $(BASE_DIR)/src

#default target name
TARGET = $(TARGET_BASE).exe

#default TECS generator
TECSGEN = tecsgen

#Time Stamp
TIMESTAMP = $(GEN_DIR)/tecsgen.timestamp

#default relocatable object (.o) directory
_TECS_OBJ_DIR = $(GEN_DIR)/



# Pre-tecsgen target
PRE_TECSGEN_TARGET =

# Post-tecsgen target
POST_TECSGEN_TARGET =

# vpath for C sources and headers
vpath %.c $(SRC_DIR) $(GEN_DIR)  ../../../config/m16c-renesas ../../../config/m16c-renesas/oaks16_mini ../../../include ../../.. ../../../syslib ../../../syslib/m16c-renesas/oaks16_mini $(TECSPATH) $(TECSPATH)/mruby $(TECSPATH)/rpc $(TECSPATH)/TLSFMalloc $(TECSPATH)/DataPumpHolder $(TECSPATH)/posix $(TECSPATH)/TECSInfo
vpath %.h $(SRC_DIR) $(GEN_DIR)  ../../../config/m16c-renesas ../../../config/m16c-renesas/oaks16_mini ../../../include ../../.. ../../../syslib ../../../syslib/m16c-renesas/oaks16_mini $(TECSPATH) $(TECSPATH)/mruby $(TECSPATH)/rpc $(TECSPATH)/TLSFMalloc $(TECSPATH)/DataPumpHolder $(TECSPATH)/posix $(TECSPATH)/TECSInfo

# Other objects (out of tecsgen)
OTHER_OBJS =                      # Add objects out of tecs care.
# OTHER_OBJS = $(_TECS_OBJ_DIR)vasyslog.o
# Rule #_MRUL_#
allall: tecs
	make all     # in order to include generated Makefile.tecsgen & Makefile.depend

all : $(TARGET)


# include dependcy #_MDEP_#
-include $(GEN_DIR)/Makefile.tecsgen
-include $(GEN_DIR)/Makefile.depend

$(TARGET) : $(TIMESTAMP) $(CELLTYPE_COBJS) $(TECSGEN_COBJS) $(PLUGIN_COBJS) $(OTHER_OBJS)
	$(LD) -o $(TARGET) $(TECSGEN_COBJS) $(CELLTYPE_COBJS) $(PLUGIN_COBJS) $(OTHER_OBJS) $(LDFLAGS)

clean :
	rm -f $(CELLTYPE_COBJS) $(TECSGEN_COBJS) $(PLUGIN_COBJS) $(OTHER_OBJS) $(TARGET)  $(TIMESTAMP)
	rm -rf $(GEN_DIR)

tecs : $(PRE_TECSGEN_TARGET) $(TIMESTAMP) $(POST_TECSGEN_TARGET)

$(TIMESTAMP) : $(TECS_IMPORTS)
	$(TECSGEN)  -v -D TECS --cpp=gcc -E -D NC30 -I../../../config/m16c-renesas -I../../../config/m16c-renesas/oaks16_mini -I../../../include -I../../.. -I../../../syslib -I../../../syslib/m16c-renesas/oaks16_mini -I. sample.cdl

#####  TECSFlow targets  #####
tecsflow : $(GEN_DIR)/tecsgen.rbdmp tcflow
	tecsflow -g $(GEN_DIR)

tecsflow_u : $(GEN_DIR)/tecsgen.rbdmp tcflow
	tecsflow -g $(GEN_DIR) -U

$(GEN_DIR)/tecsgen.rbdmp : tecs

tcflow : tecs
	make tcflow_exec

tcflow_exec : $(GEN_DIR)/tcflow.rbdmp
$(GEN_DIR)/tcflow.rbdmp : $(CELLTYPE_SRCS) $(PLUGIN_CELLTYPE_SRCS)
	tcflow -g $(GEN_DIR) -c '$(CC) -E -DTECSFLOW $(CFLAGS) -I ./' $^
	# add -DTECSGEN if many errors occur, especially in case using cygwin, linux
#####  end TECSFlow targets  #####

