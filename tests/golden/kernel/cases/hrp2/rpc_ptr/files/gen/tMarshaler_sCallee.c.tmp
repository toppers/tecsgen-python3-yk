 * #[</ENTRY_PORT>]# */

/* #[<ENTRY_FUNC>]# eClientEntry_add
 * name:         eClientEntry_add
 * global_name:  tMarshaler_sCallee_eClientEntry_add
 * oneway:       false
 * #[</ENTRY_FUNC>]# */
ER
eClientEntry_add(CELLIDX idx, int32_t a, int32_t b, int32_t* sum)
{
    ER  retval_ = E_OK;
    ER      ercd_;
    FLGPTN  flgptn;
    int16_t  func_id_ = 1;    /* id of add: 1 */
    uint8_t  msg[256];
    tMarshaler_sCallee_CB *p_cellcb;

    if( VALID_IDX( idx ) ){
        p_cellcb = GET_CELLCB(idx);
    }else{
         return ERCD( E_RPC, E_ID );
    }
    ///* Channel Lock */
    //if( is_cLockChannel_joined() )
    //  cLockChannel_wait();

    /* Èñ¢Êï∞ id „ÅÆÈÄÅÂá∫ */
    *((int16_t *)(&msg[0])) = func_id_;
    /* ÂÖ•ÂäõÂºïÊï∞ÈÄÅÂá∫ */
    *((int32_t *)(&msg[2])) = a;
    *((int32_t *)(&msg[6])) = b;
    *((int32_t* *)(&msg[10])) = sum;
