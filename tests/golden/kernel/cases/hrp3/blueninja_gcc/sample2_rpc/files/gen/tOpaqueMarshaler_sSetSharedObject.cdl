// GenOpaqueMarshler0001
celltype tOpaqueMarshaler_sSetSharedObject {
  entry ::sSetSharedObject eClientEntry;
  call sTDR       cTDR;
  [optional]
    call sSemaphore cLockChannel;
  [optional]
    call sRPCErrorHandler cErrorHandler;
};
celltype tOpaqueUnmarshaler_sSetSharedObject {
  call ::sSetSharedObject cServerCall;
  call  sTDR       cTDR;
  [optional]
    call sRPCErrorHandler cErrorHandler;
  entry sUnmarshalerMain  eService;
};
