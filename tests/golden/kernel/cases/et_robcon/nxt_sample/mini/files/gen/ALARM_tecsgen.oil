	ALARM AlarmCallbackButtonCheck {
		COUNTER = SystemTickCounter;
		ACTION = ALARMCALLBACK {
			ALARMCALLBACKNAME = "CyclicHandlerButtonCheck";
		};
		AUTOSTART = TRUE {
			ALARMTIME = 10;
			CYCLETIME = 10;
			APPMODE = appmode1;
		};
	};

	ALARM SampleAlarm {
		COUNTER = SystemTickCounter;
		ACTION = ALARMCALLBACK {
			ALARMCALLBACKNAME = "CALLBACK_SampleAlarm";
		};
		AUTOSTART = TRUE {
			ALARMTIME = 1;
			CYCLETIME = 1000;
			APPMODE = appmode1;
		};
	};

	ALARM AVR_AlarmCallbackAVR {
		COUNTER = SystemTickCounter;
		ACTION = ALARMCALLBACK {
			ALARMCALLBACKNAME = "CyclicHandlerAVR";
		};
		AUTOSTART = TRUE {
			ALARMTIME = 1;
			CYCLETIME = 1;
			APPMODE = appmode1;
		};
	};

	ALARM Button_AlarmCallbackButtonUpdate {
		COUNTER = SystemTickCounter;
		ACTION = ALARMCALLBACK {
			ALARMCALLBACKNAME = "CyclicHandlerButtonUpdate";
		};
		AUTOSTART = TRUE {
			ALARMTIME = 10;
			CYCLETIME = 10;
			APPMODE = appmode1;
		};
	};

