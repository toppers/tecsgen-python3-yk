	TASK ConnectBluetoothTask {
		AUTOSTART = TRUE {
			APPMODE = appmode1;
		};
		PRIORITY = 6;
		ACTIVATION = 1;
		SCHEDULE = FULL;
		EVENT = BluetoothEvent;
		EVENT = DelayConnectBluetoothTask_Event;
		STACKSIZE = 512;
	};

	TASK CommandTask {
		AUTOSTART = FALSE;
		PRIORITY = 7;
		ACTIVATION = 1;
		SCHEDULE = FULL;
		STACKSIZE = 4096;
	};

