/*
 * MrubyBridgeSignaturePlugin:
 *     signature=::sLowFile
 *
 *   => celltype=nMruby::tsLowFile
 *      (bridge cell's celltype; generated in this file)
 *      cell nMruby::tsLowFile BridgeCellName { cTECS = CellName.eEntry; };
 *        where eEntry's signature must be ::sLowFile.
 *      => class=TECS::TsLowFile
 *         (mruby's class; accessible from your script)
 *          bridge = TECS::TsLowFile.new("BridgeCellName")
 */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMruby{
    // bridge celltype
    [idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tsLowFile {
        call ::sLowFile cTECS;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tsLowFile_Initializer {
        entry sInitializeTECSBridge eInitialize;
    };
};
