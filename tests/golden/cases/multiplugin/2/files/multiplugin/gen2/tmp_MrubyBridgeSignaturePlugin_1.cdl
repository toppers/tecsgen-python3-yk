/*
 * MrubyBridgeSignaturePlugin:
 *     signature=::sSimpleA
 *
 *   => celltype=nMruby::tsSimpleA
 *      (bridge cell's celltype; generated in this file)
 *      cell nMruby::tsSimpleA BridgeCellName { cTECS = CellName.eEntry; };
 *        where eEntry's signature must be ::sSimpleA.
 *      => class=TECS::TsSimpleA
 *         (mruby's class; accessible from your script)
 *          bridge = TECS::TsSimpleA.new("BridgeCellName")
 */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMruby{
    // bridge celltype
    [idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tsSimpleA {
        call ::sSimpleA cTECS;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tsSimpleA_Initializer {
        entry sInitializeTECSBridge eInitialize;
    };
};
