 /*
  * MrubyInfoBridgeSignaturePlugin:
  *     signature=::sSemaphore
  *
  *   => celltype=nMrubyInfo::tInfosSemaphore
  *      (bridge cell 's celltype; generated in this file)
  *      cell nMrubyInfo::tInfosSemaphore BridgeCellName { cTECS = CellName.eEntry; };
  *        where eEntry's signature must be ::sSemaphore.
  *      => class=TECS::InfosSemaphore
  *         (mruby’s class; accessible from your script)
  *          bridge = TECS::InfosSemaphore.new("BridgeCellName")
  */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMrubyInfo{
    // bridge celltype
    [singleton, idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tInfosSemaphore {
        [dynamic,optional]
            call ::sSemaphore cTECS;
        call nTECSInfo::sTECSInfo cTECSInfo;
        [dynamic,optional]
            call nTECSInfo::sEntryInfo cEntryInfo;
        [dynamic,optional]
            call nTECSInfo::sSignatureInfo cSignatureInfo;
        [dynamic,optional]
            call nTECSInfo::sRawEntryDescriptorInfo cRawEntryDescriptorInfo;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tInfosSemaphore_Initializer {
        entry nMruby::sInitializeTECSBridge eInitialize;
    };
};

// Bridge Cell
cell nMrubyInfo::tInfosSemaphore MrubyInfoBridge_sSemaphore {
  // cTECS = Sample.eEnt;
  cTECSInfo = TECSInfo.eTECSInfo;
  // bridgeName = "Simple";
};
namespace nMruby{
    [singleton]
    celltype t_rsem {
        entry nMruby::sInitializeTECSBridge eInitialize;
    };
};
