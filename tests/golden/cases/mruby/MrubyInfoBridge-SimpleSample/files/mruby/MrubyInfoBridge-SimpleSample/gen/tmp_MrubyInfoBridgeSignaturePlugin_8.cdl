 /*
  * MrubyInfoBridgeSignaturePlugin:
  *     signature=::sEventflag
  *
  *   => celltype=nMrubyInfo::tInfosEventflag
  *      (bridge cell 's celltype; generated in this file)
  *      cell nMrubyInfo::tInfosEventflag BridgeCellName { cTECS = CellName.eEntry; };
  *        where eEntry's signature must be ::sEventflag.
  *      => class=TECS::InfosEventflag
  *         (mruby’s class; accessible from your script)
  *          bridge = TECS::InfosEventflag.new("BridgeCellName")
  */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMrubyInfo{
    // bridge celltype
    [singleton, idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tInfosEventflag {
        [dynamic,optional]
            call ::sEventflag cTECS;
        call nTECSInfo::sTECSInfo cTECSInfo;
        [dynamic,optional]
            call nTECSInfo::sEntryInfo cEntryInfo;
        [dynamic,optional]
            call nTECSInfo::sSignatureInfo cSignatureInfo;
        [dynamic,optional]
            call nTECSInfo::sRawEntryDescriptorInfo cRawEntryDescriptorInfo;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tInfosEventflag_Initializer {
        entry nMruby::sInitializeTECSBridge eInitialize;
    };
};

// Bridge Cell
cell nMrubyInfo::tInfosEventflag MrubyInfoBridge_sEventflag {
  // cTECS = Sample.eEnt;
  cTECSInfo = TECSInfo.eTECSInfo;
  // bridgeName = "Simple";
};
namespace nMruby{
    [singleton]
    celltype t_rflg {
        entry nMruby::sInitializeTECSBridge eInitialize;
    };
};
