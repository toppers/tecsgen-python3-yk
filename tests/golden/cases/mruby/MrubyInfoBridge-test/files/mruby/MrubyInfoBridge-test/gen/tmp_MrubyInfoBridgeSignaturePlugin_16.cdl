 /*
  * MrubyInfoBridgeSignaturePlugin:
  *     signature=::nPosix::sMain
  *
  *   => celltype=nMrubyInfo::tInfonPosix_sMain
  *      (bridge cell 's celltype; generated in this file)
  *      cell nMrubyInfo::tInfonPosix_sMain BridgeCellName { cTECS = CellName.eEntry; };
  *        where eEntry's signature must be ::nPosix::sMain.
  *      => class=TECS::InfonPosix_sMain
  *         (mruby’s class; accessible from your script)
  *          bridge = TECS::InfonPosix_sMain.new("BridgeCellName")
  */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMrubyInfo{
    // bridge celltype
    [singleton, idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tInfonPosix_sMain {
        [dynamic,optional]
            call ::nPosix::sMain cTECS;
        call nTECSInfo::sTECSInfo cTECSInfo;
        [dynamic,optional]
            call nTECSInfo::sEntryInfo cEntryInfo;
        [dynamic,optional]
            call nTECSInfo::sSignatureInfo cSignatureInfo;
        [dynamic,optional]
            call nTECSInfo::sRawEntryDescriptorInfo cRawEntryDescriptorInfo;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tInfonPosix_sMain_Initializer {
        entry nMruby::sInitializeTECSBridge eInitialize;
    };
};

// Bridge Cell
cell nMrubyInfo::tInfonPosix_sMain MrubyInfoBridge_nPosix_sMain {
  // cTECS = Sample.eEnt;
  cTECSInfo = TECSInfo.eTECSInfo;
  // bridgeName = "Simple";
};
