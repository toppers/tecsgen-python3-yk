 /*
  * MrubyInfoBridgeSignaturePlugin:
  *     signature=::nTECSInfo::sAccessor
  *
  *   => celltype=nMrubyInfo::tInfonTECSInfo_sAccessor
  *      (bridge cell 's celltype; generated in this file)
  *      cell nMrubyInfo::tInfonTECSInfo_sAccessor BridgeCellName { cTECS = CellName.eEntry; };
  *        where eEntry's signature must be ::nTECSInfo::sAccessor.
  *      => class=TECS::InfonTECSInfo_sAccessor
  *         (mruby’s class; accessible from your script)
  *          bridge = TECS::InfonTECSInfo_sAccessor.new("BridgeCellName")
  */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMrubyInfo{
    // bridge celltype
    [singleton, idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tInfonTECSInfo_sAccessor {
        [dynamic,optional]
            call ::nTECSInfo::sAccessor cTECS;
        call nTECSInfo::sTECSInfo cTECSInfo;
        [dynamic,optional]
            call nTECSInfo::sEntryInfo cEntryInfo;
        [dynamic,optional]
            call nTECSInfo::sSignatureInfo cSignatureInfo;
        [dynamic,optional]
            call nTECSInfo::sRawEntryDescriptorInfo cRawEntryDescriptorInfo;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tInfonTECSInfo_sAccessor_Initializer {
        entry nMruby::sInitializeTECSBridge eInitialize;
    };
};

// Bridge Cell
cell nMrubyInfo::tInfonTECSInfo_sAccessor MrubyInfoBridge_nTECSInfo_sAccessor {
  // cTECS = Sample.eEnt;
  cTECSInfo = TECSInfo.eTECSInfo;
  // bridgeName = "Simple";
};
