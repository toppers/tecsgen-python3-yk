/*
 * MrubyBridgeSignaturePlugin:
 *     signature=::sSig
 *
 *   => celltype=nMruby::tsSig
 *      (bridge cell's celltype; generated in this file)
 *      cell nMruby::tsSig BridgeCellName { cTECS = CellName.eEntry; };
 *        where eEntry's signature must be ::sSig.
 *      => class=TECS::TsSig
 *         (mruby's class; accessible from your script)
 *          bridge = TECS::TsSig.new("BridgeCellName")
 */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMruby{
    // bridge celltype
    [idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tsSig {
        call ::sSig cTECS;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tsSig_Initializer {
        entry sInitializeTECSBridge eInitialize;
    };
};
namespace nMruby{
    [singleton]
    celltype tag {
        entry sInitializeTECSBridge eInitialize;
    };
};
