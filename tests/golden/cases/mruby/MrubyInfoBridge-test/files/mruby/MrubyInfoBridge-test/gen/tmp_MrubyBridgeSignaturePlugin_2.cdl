/*
 * MrubyBridgeSignaturePlugin:
 *     signature=::nTECSInfo::sAccessor
 *
 *   => celltype=nMruby::tnTECSInfo_sAccessor
 *      (bridge cell's celltype; generated in this file)
 *      cell nMruby::tnTECSInfo_sAccessor BridgeCellName { cTECS = CellName.eEntry; };
 *        where eEntry's signature must be ::nTECSInfo::sAccessor.
 *      => class=TECS::TnTECSInfo_sAccessor
 *         (mruby's class; accessible from your script)
 *          bridge = TECS::TnTECSInfo_sAccessor.new("BridgeCellName")
 */
import( <mruby.cdl> );

/****  Ruby => TECS Bridge Celltype (MBP500) ****/
namespace nMruby{
    // bridge celltype
    [idx_is_id,active]   // not actually active, to avoid warning W1002, W1007
    celltype tnTECSInfo_sAccessor {
        call ::nTECSInfo::sAccessor cTECS;
        attr {
            [omit]
            char_t *VMname = "VM";
            [omit]
            char_t *bridgeName = C_EXP( "$cell$" );
        };
    };
    // bridge initializer celltype
    celltype tnTECSInfo_sAccessor_Initializer {
        entry sInitializeTECSBridge eInitialize;
    };
};
